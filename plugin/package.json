{
  "name": "pdf-to-md-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin: local PDF → Markdown with granite-docling on WebGPU.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "install:vault": "node install.mjs",
    "deploy": "node esbuild.config.mjs && node install.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.5",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.5.0",
    "typescript": "^5.6.0"
  }
}
