{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    // onnxruntime-web's package.json "exports" hides its own types.d.ts from
    // Bundler-mode resolution; point at it directly.
    "paths": { "onnxruntime-web": ["./node_modules/onnxruntime-web/types.d.ts"] }
  },
  "include": ["*.ts", "../engine-js/src/**/*.ts"]
}
